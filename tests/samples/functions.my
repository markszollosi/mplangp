def fact(n):
    if n <= 1:
        return 1
    return n * fact(n - 1)

def fib(n):
    a = 0
    b = 1
    while n > 0:
        t = a + b
        a = b
        b = t
        n = n - 1
    return a

def greet(name, times):
    return ("hello " + name + " ") * times

def nothing():
    x = 1

x = 100
def shadow():
    x = 1
    return x

def bump():
    return x + 1

print(fact(10))
print(fib(30))
print(greet("mp", 2))
print(nothing())
print(shadow())
print(x)
print(bump())
print(fact(3) + fact(4) * 2)
