xs = [3, 1, 2]
push(xs, 10)
print(xs)
print(len(xs))
print(xs[0] + xs[-1])
xs[1] = 99
print(xs)
sort(xs)
print(xs)
print(xs + [7])
print(slice(xs, 1, 3))
print(pop(xs))
print(2 in [1, 2, 3])
print("x" in "xyz")

m = {"a": 1, "b": [1, 2], "c": {"d": "e"}}
print(m)
print(m["c"]["d"])
m["z"] = None
print(keys(m))
print(has(m, "b"))
print("b" in m)
print(get(m, "nope", 5))
remove(m, "a")
print(len(m))

total = 0
for x in range(5):
    if x == 3:
        continue
    total = total + x
print(total)

for k in {"p": 1, "q": 2}:
    print(k)

for ch in "abc":
    print(ch)

for i in range(3):
    for j in range(3):
        if j == 2:
            break
        print(text(i) + text(j))

def sum(items):
    s = 0
    for v in items:
        s = s + v
    return s

print(sum([1, 2, 3]))
print(sum(range(101)))
print([1, [2, 3]] == [1, [2, 3]])
print(type([]) + type({}) + type(1))
print(int("42") + 1)
print(float("1.5"))
a = [1]
b = a
push(b, 2)
print(a)
print({
    "multi": [
        1,
        2,
    ],
})
